# Base de datos Postgres (en Vercel la crea la integración de Neon)
DATABASE_URL=postgres://usuario:clave@host:5432/divas
# Opcional: conexión directa para migraciones (Neon)
DATABASE_URL_UNPOOLED=

# Secreto para firmar sesiones (texto largo y aleatorio)
AUTH_SECRET=

# Clave inicial de la cuenta de Minerva (usuario: minerva)
ADMIN_PASSWORD=

# URL pública del sitio
NEXT_PUBLIC_SITE_URL=https://siempredivas.vercel.app

# Opcional: notificaciones push (npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Opcional: WhatsApp a la dueña vía CallMeBot (también se configura en Ajustes)
CALLMEBOT_APIKEY=
